<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(MSBuildProjectDirectory)\Version.props" />
    <PropertyGroup>
        <SolutionDir Condition=" '$(SolutionDir)' == '' ">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), UnifiedLogging.sln))\</SolutionDir>
        <TargetFrameworks>net9.0;net9.0-ios;net9.0-maccatalyst;net8.0;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
        <OutputType>Library</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>com.mahonkin.tim.Logging.UnifiedLogging</RootNamespace>
    	<BuildInParallel>true</BuildInParallel>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Mahonkin.UnifiedLogging</PackageId>
        <Title>Apple Unified Logging implemented as a LoggerProvider.</Title>
        <Description>            
            Implementation of ILogger &amp; ILoggerProvider for Apple Unified Logging. Uses the Mahonkin.OSLogger package that provides a native Apple Unified Logging OSLog object to write log messages.
        </Description>
        <Authors>Timothy G. Reynolds</Authors>
        <Company />
        <Copyright>Copyright © 2023-2026 Timothy G. Reynolds</Copyright>
        <PackageTags>macos;ios;maccatalyst;oslog;logging;logging-provider;log;logger;unified-logging;maui;xamarin</PackageTags>
        <PackageProjectUrl>https://github.com/timgreynolds/UnifiedLogging </PackageProjectUrl>
        <RepositoryUrl>git@github.com:timgreynolds/UnifiedLogging.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>master</RepositoryBranch>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Logo.png</PackageIcon>
        <PackageReleaseNotes />
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" $(Configuration.Contains('Debug'))">
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedAllSources>true</EmbedAllSources>
        <DebugType>Embedded</DebugType>
        <VersionPrefix Condition=" 'LastReleaseVersion' != '' ">$(LastReleaseVersion)</VersionPrefix>
        <VersionSuffix Condition=" '$(Configuration)' == 'Debug' And 'LastReleaseDateTime' != '' ">$([System.Convert]::ToInt32($([System.TimeSpan]::FromTicks($([MsBuild]::Subtract($([System.DateTime]::Now.Ticks), $([System.DateTime]::Parse($(LastReleaseDateTime)).Ticks)))).TotalMinutes)))</VersionSuffix>
        <VersionSuffix Condition=" $(Configuration.Contains('Release')) And 'LastReleaseVersion' != '' ">DEBUG</VersionSuffix>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'DebugRelease'">
        <OutputPath>bin\Debug</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release'">
        <IncludeSymbols>false</IncludeSymbols>
        <EmbedAllSources>false</EmbedAllSources>
        <DebugType>none</DebugType>
	    <MajorNumber Condition=" 'LastReleaseVersion' != '' ">$([System.Version]::Parse($(LastReleaseVersion)).Major)</MajorNumber>
        <MinorNumber Condition=" 'LastReleaseVersion' != '' ">$([System.Version]::Parse($(LastReleaseVersion)).Minor)</MinorNumber>
        <!-- Increment Build Number on 'Release' build -->
        <BuildNumber Condition=" 'LastReleaseVersion' != '' ">$([MSBuild]::Add($([System.Version]::Parse($(LastReleaseVersion)).Build), 1))</BuildNumber>
        <VersionPrefix Condition=" 'LastReleaseVersion' != '' ">$(MajorNumber).$(MinorNumber).$(BuildNumber)</VersionPrefix>
        <VersionSuffix />
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="Images\Logo.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Mahonkin.OSLogger" Version="2.1.0-DEBUG" />
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.*" />
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.*" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
    </ItemGroup>
    <Target Name="SaveLastReleaseVersion" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' And '$(VersionPrefix)' != '' ">
        <PropertyGroup>
            <LinesToWrite>
&lt;Project&gt;
  &lt;PropertyGroup&gt;
    &lt;LastReleaseVersion&gt;
      $(VersionPrefix)
    &lt;/LastReleaseVersion&gt;
    &lt;LastReleaseDateTime&gt;
      $([System.DateTime]::Now.ToString(yyyy/MM/dd HH:mm:00))
    &lt;/LastReleaseDateTime&gt;
  &lt;/PropertyGroup&gt;
&lt;/Project&gt;
            </LinesToWrite>
        </PropertyGroup>
        <WriteLinesToFile File="$(MSBuildProjectDirectory)\Version.props" Lines="$(LinesToWrite)" Overwrite="true" Encoding="UTF-8" />
    </Target>
</Project>
