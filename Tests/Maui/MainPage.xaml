<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="com.mahonkin.tim.Logging.UnifiedLogging.Tests.Maui.MainPage">
    <ScrollView>
        <VerticalStackLayout
            BackgroundColor="DarkGray"
            Padding="30,0"
            Spacing="25">
            <Image
                Source="logo.png"
                HeightRequest="128"
                Aspect="AspectFit"/>
            <Label
                Text="Unified Logging Maui Test Application"
                TextColor="Black"
                Style="{StaticResource Headline}"/>
            <Grid
                Margin="5"
                RowSpacing="5"
                ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Picker x:Name="LevelPicker"
                        Grid.Row="0"
                        Grid.Column="1"
                        Title="Select Level"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="Black"/>
                <Button x:Name="CounterBtn"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="Click me"
                        Clicked="OnCounterClicked"
                        HorizontalOptions="Center"
                        TextColor="DarkGray"
                        BackgroundColor="Black"
                        CornerRadius="20"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
